{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format console
	}

	# The identity pages are top-level and unprefixed on purpose. Routing them here rather than
	# giving them a prefix is what puts the whole site on one origin, and one origin is what keeps
	# the session cookie, the same-origin redirect check and the cross-origin form protection
	# working exactly as they do in the single binary. Do not add a prefix.
	#
	# These are exact matches, not prefixes: /loginfoo belongs to the site and answers 404 there.
	@identity path /setup /login /logout /register /password
	handle @identity {
		reverse_proxy auth:8080
	}

	# The gateway's own liveness. It deliberately does not proxy any service's probe: whether a
	# service is ready is an operational fact for the container runtime, not something a visitor
	# gets to ask, and /readyz touches the database.
	handle /healthz {
		respond "ok" 200
	}

	# Everything else is the site.
	handle {
		reverse_proxy web:8080
	}
}

# Nothing routes to authz:8080 or content:8080, and nothing routes /v1. Those services are
# reachable only from the compose network, which is what keeps the internal APIs off the internet.
