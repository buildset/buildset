{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format console
	}

	# Routing the identity pages here rather than prefixing them puts the whole site on one origin,
	# which is what keeps the session cookie, the same-origin redirect check and the cross-origin
	# form protection working. Do not add a prefix.
	#
	# These are exact matches: /loginfoo belongs to the site and answers 404 there.
	@identity path /setup /login /logout /register /password
	handle @identity {
		reverse_proxy auth:8080
	}

	# The gateway's own liveness. No service's probe is proxied: readiness is a fact for the
	# container runtime, not something a visitor gets to ask, and /readyz touches the database.
	handle /healthz {
		respond "ok" 200
	}

	# Everything else is the site.
	handle {
		reverse_proxy web:8080
	}
}

# Nothing routes to authz:8080, content:8080 or /v1. Those services are reachable only from the
# compose network, which keeps the internal APIs off the internet.
