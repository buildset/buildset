# Host the HTTP server binds to. Empty means every interface.
HOST=

# Port the HTTP server listens on.
PORT=8080

# Level for structured logs: debug, info, warn, error.
LOG_LEVEL=info

# Emit logs as JSON instead of human-readable text.
LOG_JSON=false

# Send the Secure attribute on the session cookie. Turn off only for plain-HTTP local development.
SECURE_COOKIES=true

# Storage backend: sqlite or postgres.
DATABASE_DRIVER=sqlite

# Path to the SQLite database file. Created on first start. Ignored by the postgres driver.
DATABASE_PATH=buildset.db

# Postgres connection string. Required when DATABASE_DRIVER=postgres. Each service is pointed at
# its own schema, so one connection string covers all three.
# DATABASE_DSN=postgres://postgres:postgres@localhost:5432/buildset?sslmode=disable

# Upper bound on each Postgres pool. SQLite always uses a single connection.
DATABASE_MAX_OPEN_CONNS=10

# bcrypt cost for new password hashes. Higher is slower and stronger.
AUTH_BCRYPT_COST=12

# How long a session stays valid after it is created.
AUTH_SESSION_TTL=336h

# Allow anyone to create an account at /register. When off, the page answers 404 to strangers and
# only the user.create permission reaches it.
AUTH_REGISTRATION_OPEN=false

# Name shown at the top of every page.
SITE_TITLE=Blog

# --- Running as separate services -------------------------------------------
#
# cmd/blog ignores everything below. Each service binary reads the same generic
# names, and compose gives each container different values.

# Base URLs of the services a binary depends on. A missing or malformed value
# fails at start-up.
# AUTH_URL=http://auth:8080
# AUTHZ_URL=http://authz:8080
# CONTENT_URL=http://content:8080

# How long one call to another service may take before the caller gives up and
# renders an error page.
# HTTP_TIMEOUT=5s

# The role the first account is given.
# AUTH_ADMIN_ROLE=admin

# Where the identity service serves its pages. The site links to these and the
# gateway routes them, so both sides must agree.
# AUTH_LOGIN_PATH=/login
# AUTH_LOGOUT_PATH=/logout
# AUTH_PASSWORD_PATH=/password
# AUTH_REGISTER_PATH=/register

# Passwords for the per-service database roles, used by compose.
# AUTH_DB_PASSWORD=auth
# AUTHZ_DB_PASSWORD=authz
# CONTENT_DB_PASSWORD=content
