# Host the HTTP server binds to. Empty means every interface.
HOST=

# Port the HTTP server listens on.
PORT=8080

# Level for structured logs: debug, info, warn, error.
LOG_LEVEL=info

# Emit logs as JSON instead of human-readable text.
LOG_JSON=false

# Send the Secure attribute on the session cookie. Turn off only for plain-HTTP local development.
SECURE_COOKIES=true

# Path to the SQLite database file. Created on first start.
DATABASE_PATH=ms.db

# bcrypt cost for new password hashes. Higher is slower and stronger.
AUTH_BCRYPT_COST=12

# How long a session stays valid after it is created.
AUTH_SESSION_TTL=336h

# Allow anyone to create an account at /register. When off, the page answers 404 to strangers and
# only someone holding the user.create permission can reach it to add an account.
AUTH_REGISTRATION_OPEN=false

# Name shown at the top of every page.
SITE_TITLE=Blog
