{{ define "content" }}
<form method="post" action="/password">
    <p><label>Current password <input name="current_password" type="password" required autofocus autocomplete="current-password"></label></p>
    <p><label>New password <input name="new_password" type="password" required autocomplete="new-password"></label></p>
    <p><button type="submit">Change password</button></p>
</form>
<p>Changing your password signs out every other browser.</p>
{{ end }}
